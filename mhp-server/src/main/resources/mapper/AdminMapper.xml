<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.mhp.mapper.AdminMapper">
    <select id="login" resultType="com.mhp.entity.SysUser">
        select * from sys_user where student_no = #{studentNo}
    </select>

    <!-- pageQuery --> 

    <select id="pageQuery" resultType="com.mhp.entity.SysUser">
        select * from sys_user 
        <where>
         <if test="realName != null and realName != ''">
                and real_name like concat('%',#{realName},'%')
            </if>
            <if test="studentNo != null and studentNo != ''">
                and student_no like concat('%',#{studentNo},'%')
            </if>
            <if test="status != null and status != ''">
                and status like concat('%',#{status},'%')
            </if>
        </where>
        order by create_time desc
    </select>

</mapper>
