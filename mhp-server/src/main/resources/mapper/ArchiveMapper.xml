<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.mhp.mapper.ArchiveMapper">
    <select id="pageQuery" resultType="com.mhp.entity.MhArchive">
        select * from mh_archive
        <where>
            <if test="name != null and name != ''">
                and name like concat('%',#{name},'%')
            </if>
            <if test="studentNo != null and studentNo != ''">
                and student_no like concat('%',#{studentNo},'%')
            </if>
            <if test="collegeId != null">
                and college_id = #{collegeId}
            </if>
            <if test="archiveStatus != null">
                and archive_status like concat('%',#{archiveStatus},'%')
            </if>
        </where>
        order by create_time desc
    </select>

    <!-- update -->

    <update id="update">
        update mh_archive
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="studentNo != null and studentNo != ''">
                student_no = #{studentNo},
            </if>
            <if test="collegeId != null">
                college_id = #{collegeId},
            </if>
            <if test="classId != null">
                class_id = #{classId},
            </if>
            <if test="archiveStatus != null">
                archive_status = #{archiveStatus}
            </if>
        </set>
        where archive_id = #{archiveId}
    </update>

</mapper>
